{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://cartshiftstudio.firebaseapp.com/__/auth/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
