# Required Environment Variables
# Copy this file to .env.local and fill in your values

# Your production domain URL (required)
NEXT_PUBLIC_SITE_URL=https://cart-shift.com
NEXT_PUBLIC_PORTAL_URL=https://portal.cart-shift.com

# Firebase Cloud Function URL for contact form submissions (required)
NEXT_PUBLIC_FIREBASE_FUNCTION_URL=https://us-central1-your-project.cloudfunctions.net/contactForm

# Google Analytics Tracking ID (optional)
# Leave empty if not using Google Analytics
NEXT_PUBLIC_GA_ID=xxxxx

# WhatsApp number for floating button (optional)
# Format: include country code without + (e.g., 972503591552 for Israel)
NEXT_PUBLIC_WHATSAPP_NUMBER=972503591552
# Company contact email (optional, defaults to hello@cart-shift.com)
# Used in invoices, contact pages, and email notifications
CONTACT_EMAIL=hello@cart-shift.com
# Required for commercial email compliance. Use the business's full postal address.
MARKETING_POSTAL_ADDRESS=
# PageSpeed Insights API Key (optional but recommended for accurate analysis)
# Get one here: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Google ReCAPTCHA v2 (required for store analyzer)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# PayPal proposal payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Firebase Admin SDK for server-only proposal acceptance and payments
# Keep these separate from GOOGLE_APPLICATION_CREDENTIALS used by other Google integrations.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Localhost-only portal dev login (for agent/browser visual testing)
# Requires an existing Firebase Auth user with portal data in Firestore.
# Never enable in production. The API returns 404 when disabled.
PORTAL_DEV_AUTH_ENABLED=false
PORTAL_DEV_AUTH_SECRET=
PORTAL_DEV_AUTH_EMAIL=
