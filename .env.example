# Required Environment Variables
# Copy this file to .env.local and fill in your values

# Firebase client SDK (required — from Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Your production domain URL
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PORTAL_URL=https://portal.example.com

# Firebase Cloud Function URL for contact form submissions (required)
NEXT_PUBLIC_FIREBASE_FUNCTION_URL=https://us-central1-your-project.cloudfunctions.net/contactForm

# Google Analytics Tracking ID (optional)
NEXT_PUBLIC_GA_ID=

# WhatsApp number for floating button (optional)
# Format: country code without + (e.g., 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Company contact email (optional)
CONTACT_EMAIL=hello@example.com

# Required for commercial email compliance
MARKETING_POSTAL_ADDRESS=

# PageSpeed Insights API Key (optional but recommended for accurate analysis)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Google ReCAPTCHA v3 (required for store analyzer)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# PayPal proposal payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Firebase Admin SDK for server-only routes (proposals, payments, portal API)
# Keep separate from GOOGLE_APPLICATION_CREDENTIALS used by SEO automation scripts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Localhost-only portal dev login (never enable in production)
# The API returns 404 when disabled or outside development.
PORTAL_DEV_AUTH_ENABLED=false
PORTAL_DEV_AUTH_SECRET=
PORTAL_DEV_AUTH_EMAIL=
