{
  "name": "cartshift-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-env.mjs --silent && node scripts/generate-i18n-types.js --silent && node scripts/merge-translations.js --silent",
    "predev": "node scripts/validate-env.mjs --silent && node scripts/generate-i18n-types.js --silent && node scripts/merge-translations.js --silent",
    "dev": "node dev-pro.mjs",
    "dev:force": "powershell -ExecutionPolicy Bypass -File scripts/dev-force-simple.ps1",
    "dev:force:win": "cmd /c scripts\\dev-force.bat",
    "dev:legacy": "next dev --turbo",
    "clean:cache": "powershell -ExecutionPolicy Bypass -File scripts/clean-turbopack-cache.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx && tsc --noEmit",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix && tsc --noEmit",
    "lint:next": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:functions": "cd functions && pnpm install && cd .. && firebase deploy --only functions",
    "vercel:deploy": "vercel --prod",
    "vercel:logs": "vercel logs",
    "analyze": "cross-env ANALYZE=true next build",
    "seo:monitor": "node scripts/seo-monitor.mjs",
    "seo:monitor:json": "node scripts/seo-monitor.mjs --json",
    "seo:monitor:apply": "node scripts/seo-monitor.mjs --apply",
    "blog:thumbnails": "node scripts/generate-blog-thumbnails.mjs",
    "social:linkedin:publish": "node scripts/publish-linkedin-post.mjs",
    "social:linkedin:publish:dry-run": "node scripts/publish-linkedin-post.mjs --dry-run",
    "normalize-db": "tsx scripts/normalize-db.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "i18n:validate": "node scripts/validate-translations.js",
    "i18n:merge": "node scripts/merge-translations.js",
    "i18n:watch": "node scripts/merge-translations-watch.js",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "diagnose:puppeteer": "node scripts/diagnose-puppeteer.js",
    "capture:cv-portfolio": "node scripts/capture-cv-portfolio-screenshots.js",
    "test:analyzer": "node scripts/test-analyzer.js",
    "test:analyzer:unit": "vitest run tests/services/analyzer.test.ts tests/api/analyze-store.route.test.ts tests/utils/safe-store-fetch.test.ts tests/utils/store-url.test.ts tests/lib/analyzer-progress.test.ts tests/hooks/use-analyzer-progress.test.tsx tests/services/analyzer-response.test.ts tests/services/ai-readiness.test.ts tests/validation/analyze-store.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.0.10",
    "@next/third-parties": "^16.0.10",
    "@paypal/react-paypal-js": "^8.9.2",
    "@react-pdf/renderer": "^4.3.1",
    "@sparticuz/chromium": "^148.0.0",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "firebase-functions": "^7.0.2",
    "framer-motion": "^11.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "next-intl": "^4.6.1",
    "next-themes": "^0.4.6",
    "puppeteer": "^24.36.0",
    "puppeteer-core": "^25.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.51.0",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@esbuild/win32-arm64": "0.27.2",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.10",
    "@rollup/rollup-win32-arm64-msvc": "^4.60.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.10.20",
    "cross-env": "^7.0.3",
    "esbuild": "0.27.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-admin": "^13.6.0",
    "jsdom": "^27.4.0",
    "jsonlint": "^1.6.3",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.4.39",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
