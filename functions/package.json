{
  "name": "functions",
  "description": "Cloud Functions for CartShift Studio",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "rimraf lib/emails && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@react-email/components": "^1.0.4",
    "@react-email/render": "^2.0.4",
    "@sparticuz/chromium": "^148.0.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "html-to-text": "^9.0.5",
    "pdfkit": "^0.17.2",
    "puppeteer-core": "^25.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.15.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
