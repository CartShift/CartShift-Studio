// Rules updated
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function isMemberOfOrg(orgId) {
      return isAuthenticated() &&
             orgId != null && orgId != '' &&
             exists(/databases/$(database)/documents/portal_members/$(orgId + '_' + getUserId())) &&
             get(/databases/$(database)/documents/portal_members/$(orgId + '_' + getUserId())).data.get('removedAt', null) == null;
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() &&
             orgId != null && orgId != '' &&
             exists(/databases/$(database)/documents/portal_organizations/$(orgId)) &&
             get(/databases/$(database)/documents/portal_organizations/$(orgId)).data.createdBy == getUserId() &&
             (!exists(/databases/$(database)/documents/portal_members/$(orgId + '_' + getUserId())) ||
               isMemberOfOrg(orgId));
    }

    function isAgencyUser() {
      // Robust agency check
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/portal_users/$(getUserId())) &&
             (
               get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('isAgency', false) == true ||
               get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('accountType', '') == 'AGENCY'
              ) &&
             !(get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('status', 'active') in ['suspended', 'inactive']);
    }

    // Role-aware agency mutations. Missing agencyRole is retained for legacy owners.
    function isAgencyManager() {
      return isAgencyUser() &&
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') in ['owner', 'admin', ''];
    }

    function canEditAgencyProjects() {
      return isAgencyUser() &&
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') in ['owner', 'admin', 'sales_manager', 'developer', ''];
    }

    function canCreateAgencyRequest() {
      return isAgencyUser() &&
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') in ['owner', 'admin', 'sales_manager', 'developer', 'member', ''];
    }

    function canManageAgencyCommercial() {
      return isAgencyUser() &&
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') in ['owner', 'admin', 'sales_manager', ''];
    }

    function canManageProfitSplits() {
      return isAgencyUser() && (
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') == 'owner' ||
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') == 'admin' ||
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') == 'sales_manager' ||
        get(/databases/$(database)/documents/portal_users/$(getUserId())).data.get('agencyRole', '') == ''
      );
    }

    function isValidProfitSplitFinalization() {
      return request.resource.data.get('status', '') == 'finalized' &&
             request.resource.data.get('totalAllocatedPercentage', 0) == 100 &&
             request.resource.data.get('netProfit', -1) >= 0;
    }

    // Helper to check if user has access to an organization
    function canAccessOrg(orgId) {
      return isAuthenticated() &&
             orgId != null && orgId != '' && (
        isAgencyUser() ||
        isMemberOfOrg(orgId) ||
        isOrgOwner(orgId)
      );
    }

    function getMemberDoc(orgId) {
      return get(/databases/$(database)/documents/portal_members/$(orgId + '_' + getUserId()));
    }

    function isOrgAdmin(orgId) {
      return isMemberOfOrg(orgId) && (
        getMemberDoc(orgId).data.get('role', '') == 'owner' ||
        getMemberDoc(orgId).data.get('role', '') == 'admin'
      );
    }

    function canAdminOrg(orgId) {
      return isAuthenticated() && (
        isOrgOwner(orgId) ||
        isAgencyManager() ||
        isOrgAdmin(orgId)
      );
    }

    // Role grants must originate from an authorized, still-pending agency invite.
    // Profile fields are self-service; role/status fields are not.
    function validAgencyPromotion() {
      let inviteId = request.resource.data.get('agencyInviteId', '');
      return inviteId is string && inviteId != '' &&
        exists(/databases/$(database)/documents/portal_invites/$(inviteId)) &&
        get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('isAgency', false) == true &&
        get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('status', '') == 'pending' &&
        get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('expiresAt', request.time) > request.time &&
        request.auth.token.email_verified == true &&
        get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('email', '') == request.auth.token.email &&
        get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('role', '') == request.resource.data.get('agencyRole', '') &&
        resource.data.get('accountType', 'CLIENT') != 'AGENCY' &&
        request.resource.data.get('accountType', '') == 'AGENCY' &&
        request.resource.data.get('isAgency', false) == true;
    }

    match /portal_users/{userId} {
      allow read: if isAuthenticated() && (
        getUserId() == userId || isAgencyUser()
      );
      allow create: if isAuthenticated() && getUserId() == userId &&
        request.resource.data.get('accountType', 'CLIENT') == 'CLIENT' &&
        request.resource.data.get('isAgency', false) == false &&
        !request.resource.data.keys().hasAny(['agencyRole', 'agencyInviteId']);
      allow update: if isAuthenticated() && getUserId() == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAgency', 'accountType', 'agencyRole', 'agencyInviteId', 'status', 'createdAt'
        ]) || validAgencyPromotion()
      );
      allow delete: if false;
    }

    match /portal_organizations/{orgId} {
      // Agency users can read any organization, members can read their own org
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        isMemberOfOrg(orgId) ||
        isOrgOwner(orgId)
      );
      allow create: if isAuthenticated() && request.resource.data.get('createdBy', '') == getUserId();
      // Only admins/owners can update (security fix - was allowing any member)
      allow update: if canAdminOrg(orgId);
      allow delete: if false;
    }

    match /portal_members/{memberId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        memberId == (resource.data.get('orgId', '') + '_' + getUserId()) ||
        canAccessOrg(resource.data.get('orgId', ''))
      );
      // Self-joining someone else's org or self-assigning owner/admin is forbidden.
      // Invitee may join only when the inviter-granted role and organization match.
      function validMemberInvite() {
        let inviteId = request.resource.data.get('inviteId', '');
        return inviteId is string && inviteId != '' &&
          exists(/databases/$(database)/documents/portal_invites/$(inviteId)) &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('orgId', '') == request.resource.data.get('orgId', '') &&
          request.auth.token.email_verified == true &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('email', '') == request.auth.token.email &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('role', '') == request.resource.data.get('role', '') &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('status', '') == 'pending' &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('expiresAt', request.time) > request.time &&
          get(/databases/$(database)/documents/portal_invites/$(inviteId)).data.get('isAgency', false) == false;
      }
      allow create: if isAuthenticated() && (
        isAgencyManager() ||
        isOrgOwner(request.resource.data.get('orgId', '')) ||
        isOrgAdmin(request.resource.data.get('orgId', '')) ||
        (memberId == (request.resource.data.get('orgId', '') + '_' + getUserId()) &&
         request.resource.data.get('userId', '') == getUserId() &&
         validMemberInvite())
      );
      // Re-invitation of a removed member updates the same deterministic
      // document ID. Only a new, unexpired invitation issued by an admin may
      // restore it, and the invite strictly dictates the recipient and role.
      function validMemberReactivation() {
        return isAuthenticated() &&
          request.auth.token.email_verified == true &&
          resource.data.get('removedAt', null) != null &&
          memberId == request.resource.data.get('orgId', '') + '_' + getUserId() &&
          resource.data.get('orgId', '') == request.resource.data.get('orgId', '') &&
          resource.data.get('userId', '') == getUserId() &&
          request.resource.data.get('userId', '') == getUserId() &&
          request.resource.data.get('email', '') == request.auth.token.email &&
          request.resource.data.get('removedAt', null) == null &&
          request.resource.data.keys().hasOnly([
            'orgId', 'userId', 'email', 'name', 'role', 'invitedBy', 'inviteId', 'joinedAt'
          ]) &&
          request.resource.data.get('joinedAt', request.time) == request.time &&
          validMemberInvite();
      }
      allow update: if resource != null && (
        canAdminOrg(resource.data.get('orgId', '')) ||
        validMemberReactivation()
      );
      allow delete: if false;
    }

    match /portal_invites/{inviteId} {
      // Verified recipients can query only invitations addressed to themselves.
      // Unrestricted listing and reads by an unverified email are forbidden.
      allow get: if isAuthenticated() && (
        isAgencyManager() ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email == resource.data.get('email', '')) ||
        canAdminOrg(resource.data.get('orgId', ''))
      );
      allow list: if isAuthenticated() && (
        isAgencyManager() ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email == resource.data.get('email', '')) ||
        canAdminOrg(resource.data.get('orgId', ''))
      );
      allow create: if isAuthenticated() && (
        isAgencyManager() ||
        (request.resource.data.get('isAgency', false) == false &&
         canAdminOrg(request.resource.data.get('orgId', '')))
      ) && request.resource.data.get('invitedBy', '') == getUserId();
      // Invitation recipients can acknowledge an invite, but cannot change
      // the invited role, email, organization, or agency flag.
      allow update: if isAuthenticated() && (
        isAgencyManager() ||
        canAdminOrg(resource.data.get('orgId', '')) ||
        (request.auth.token.email_verified == true &&
         resource.data.get('email', '') == request.auth.token.email &&
         resource.data.get('status', '') == 'pending' &&
         request.resource.data.get('status', '') in ['accepted', 'expired'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']))
      );
      allow delete: if resource != null && canAdminOrg(resource.data.get('orgId', ''));
    }

    // Shared projects are readable by the owning organization; only agency users
    // may edit project scope, launch checks, blockers and client-facing updates.
    match /portal_projects/{projectId} {
      // Agency queries span all clients. Keep that read independent of a
      // document-field constraint so Firestore can authorize unfiltered lists.
      // Client reads remain constrained to organizations they can access.
      allow get, list: if isAgencyUser() ||
        (resource != null && canAccessOrg(resource.data.get('orgId', '')));
      allow create: if canEditAgencyProjects() &&
        request.resource.data.get('orgId', '') is string &&
        request.resource.data.get('status', '') == 'planning' &&
        exists(/databases/$(database)/documents/portal_organizations/$(request.resource.data.orgId));
      // 'ready_to_launch' can only be entered by the trusted readiness service.
      // Editing gates after readiness requires atomically reopening the project.
      allow update: if canEditAgencyProjects() &&
        request.resource.data.get('orgId', '') == resource.data.get('orgId', '') &&
        (request.resource.data.get('status', '') != 'ready_to_launch' ||
          (resource.data.get('status', '') == 'ready_to_launch' &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'blockers', 'inputs', 'launchChecks', 'deliverables', 'changes', 'reviewRevisions', 'stages'
           ])));
      allow delete: if false;

      match /private_records/{recordId} {
        function projectExists() {
          return exists(/databases/$(database)/documents/portal_projects/$(projectId));
        }
        function validRecord() {
          return request.resource.data.keys().hasOnly([
            'kind', 'title', 'details', 'status', 'sourceUrl', 'owner',
            'dueDate', 'hours', 'createdBy', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'kind', 'title', 'details', 'status', 'sourceUrl', 'owner',
            'dueDate', 'createdBy', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.get('kind', '') in [
            'decision', 'qa', 'dependency', 'follow_up', 'time'
          ] &&
          request.resource.data.get('title', '') is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 160 &&
          request.resource.data.get('details', '') is string &&
          request.resource.data.details.size() <= 3000 &&
          request.resource.data.get('owner', '') is string &&
          request.resource.data.owner.size() <= 100 &&
          request.resource.data.get('sourceUrl', '') is string &&
          request.resource.data.sourceUrl.size() <= 1024 &&
          request.resource.data.get('dueDate', '') is string &&
          request.resource.data.dueDate.size() <= 10 &&
          request.resource.data.get('createdBy', '') == getUserId() &&
          request.resource.data.get('createdAt', request.time) == request.time &&
          request.resource.data.get('updatedAt', request.time) == request.time &&
          (
            (request.resource.data.kind == 'time' &&
              request.resource.data.status == 'done' &&
              request.resource.data.get('hours', 0) is number &&
              request.resource.data.hours > 0 &&
              request.resource.data.hours <= 24) ||
            (request.resource.data.kind != 'time' &&
              !request.resource.data.keys().hasAny(['hours']) &&
              request.resource.data.status == 'open')
          );
        }
        allow get, list: if isAgencyUser() && projectExists();
        allow create: if canEditAgencyProjects() && projectExists() && validRecord();
        allow update: if canEditAgencyProjects() && projectExists() &&
          resource.data.get('kind', '') != 'time' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt'
          ]) &&
          request.resource.data.get('updatedAt', request.time) == request.time &&
          (
            (resource.data.kind == 'decision' &&
              request.resource.data.status in ['open', 'confirmed']) ||
            (resource.data.kind == 'qa' &&
              request.resource.data.status in ['open', 'passed', 'failed']) ||
            (resource.data.kind in ['dependency', 'follow_up'] &&
              request.resource.data.status in ['open', 'done'])
          );
        allow delete: if false;
      }

      match /reviews/{reviewId} {
        function projectOrg() {
          return get(/databases/$(database)/documents/portal_projects/$(projectId)).data.get('orgId', '');
        }
        function validReview() {
          let project = get(/databases/$(database)/documents/portal_projects/$(projectId)).data;
          let deliverableId = request.resource.data.get('deliverableId', '');
          return exists(/databases/$(database)/documents/portal_projects/$(projectId)) &&
            !isAgencyUser() &&
            project.get('status', '') != 'ready_to_launch' &&
            project.get('reviewRevisions', {}).get(deliverableId, 0) == request.resource.data.get('revision', 0) &&
            request.resource.data.get('updatedAt', request.time) == request.time &&
            request.resource.data.keys().hasOnly([
              'projectId', 'orgId', 'deliverableId', 'reviewerId',
              'revision', 'decision', 'comment', 'updatedAt'
            ]) &&
            request.resource.data.get('projectId', '') == projectId &&
            request.resource.data.get('orgId', '') == projectOrg() &&
            request.resource.data.get('reviewerId', '') == request.auth.uid &&
            reviewId == request.resource.data.get('deliverableId', '') + '_' + request.auth.uid &&
            request.resource.data.get('deliverableId', '') is string &&
            request.resource.data.get('revision', 0) is int &&
            request.resource.data.get('revision', 0) > 0 &&
            request.resource.data.get('decision', '') in ['approved', 'changes_requested'] &&
            request.resource.data.get('comment', '') is string &&
            request.resource.data.get('comment', '').size() <= 3000;
        }
        allow read: if isAuthenticated() && canAccessOrg(projectOrg());
        allow create: if isAuthenticated() && canAccessOrg(projectOrg()) && validReview();
        allow update: if isAuthenticated() && canAccessOrg(projectOrg()) &&
          resource.data.get('reviewerId', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'revision', 'decision', 'comment', 'updatedAt'
          ]) && validReview();
        allow delete: if false;
      }
    }

    match /portal_requests/{requestId} {
      function isCommercialDocument(data) {
        return data.get('isBillable', false) == true ||
          data.get('publicToken', '') != '' ||
          data.get('requestRole', '') in ['bundle', 'bundle_item'];
      }

      function validNewProjectLink() {
        let projectId = request.resource.data.get('projectId', '');
        return projectId == null || projectId == '' ||
          (projectId is string &&
           exists(/databases/$(database)/documents/portal_projects/$(projectId)) &&
           get(/databases/$(database)/documents/portal_projects/$(projectId)).data.get('orgId', '') ==
             request.resource.data.get('orgId', ''));
      }

      function changesServerManagedCommercialFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'acceptedByName',
                 'acceptedByEmail',
                 'signatureText',
                 'termsAcceptedAt',
                 'acceptedIp',
                 'acceptedUserAgent',
                 'lockedAt',
                 'amountPaid',
                 'pendingAmount',
                 'paymentIds',
                 'paymentAllocations',
                 'paymentId',
                 'paymentMethod',
                 'paidAt',
                 // Only server transactions may publish a commercial version,
                 // finalize acceptance evidence or alter material readiness.
                 'publishedProposal',
                 'proposalVersion',
                 'proposalRequirementStatuses',
                 'quoteEmailQueueId',
                 'quoteEmailRecipient',
                 'sentAt',
                 'lastSentAt'
               ]);
      }

      // A published proposal can only be accepted or marked executable by the
      // server-side signing and billing workflow, not by a client's direct SDK write.
      function attemptsUnsignedProposalApproval() {
        return resource.data.get('proposalVersion', 0) > 0 &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) &&
          request.resource.data.get('status', '') in ['ACCEPTED', 'PAID', 'QUEUED', 'IN_PROGRESS'];
      }

      function changesAgencyCommercialFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBillable',
          'publicToken',
          'publicAccessEnabled',
          'requestRole',
          'parentRequestId',
          'childRequestIds',
          'legacyProposalId',
          'projectId',
          'lineItems',
          'totalAmount',
          'subtotal',
          'taxRate',
          'taxAmount',
          'currency',
          'terms',
          'proposalContent',
          'relatedRequestId',
          'projectChangeId',
          'depositAmount',
          'paymentRequired',
          'balanceDue',
          'paymentStatus'
        ]);
      }

      // A signed commercial agreement is not an editable operational request.
      // Trusted billing/conversion transactions use the Admin SDK and retain
      // authority to record payments, approvals and versioned change orders.
      function editsSignedCommercialTerms() {
        return isCommercialDocument(resource.data) &&
          (resource.data.get('lockedAt', null) != null ||
           resource.data.get('status', '') in [
             'ACCEPTED', 'PAID', 'QUEUED', 'IN_PROGRESS', 'IN_REVIEW', 'DELIVERED', 'CLOSED'
           ]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'orgId', 'projectId', 'projectChangeId', 'relatedRequestId',
            'title', 'description', 'lineItems', 'totalAmount', 'subtotal',
            'taxRate', 'taxAmount', 'currency', 'terms', 'proposalContent',
            'paymentRequired', 'depositAmount', 'clientEmail', 'clientName',
            'validUntil', 'timeframe', 'workDeadline', 'publicToken',
            'publicAccessEnabled'
          ]);
      }

      // Clients can read requests pre-assigned to their email (before registration)
      // or requests in orgs they're members of
      // Commercial records contain private working drafts and notes.
      // Clients get only the published, whitelisted server projection instead.
      // Queries containing both private proposals and public requests cannot be
      // authorized safely against arbitrary result sets. Client lists use the
      // authenticated, field-projected portal API instead.
      allow list: if isAuthenticated() && isAgencyUser();
      // SDK reads disclose *every* field, including private notes added later.
      // All client reads (including ordinary requests) use the authenticated,
      // explicitly whitelisted client-requests API instead.
      allow get: if isAuthenticated() && isAgencyUser();
      allow create: if isAuthenticated() && (
        canCreateAgencyRequest() ||
        (!isAgencyUser() && isMemberOfOrg(request.resource.data.get('orgId', ''))) ||
        (!isAgencyUser() && isOrgOwner(request.resource.data.get('orgId', '')))
      ) && validNewProjectLink() &&
      (canCreateAgencyRequest() || (
        !isCommercialDocument(request.resource.data) &&
        request.resource.data.get('status', '') == 'NEW' &&
        request.resource.data.get('createdBy', '') == request.auth.uid &&
        request.resource.data.get('requestRole', '') == 'standalone' &&
        request.resource.data.get('commentCount', 0) == 0 &&
        request.resource.data.keys().hasOnly([
          'orgId', 'projectId', 'title', 'description', 'type', 'status',
          'priority', 'requestRole', 'createdBy', 'createdByName', 'tags',
          'attachmentIds', 'commentCount', 'createdAt', 'updatedAt'
        ])
      ));
      allow update: if isAuthenticated() && (
        resource == null ||
        resource.data.get('createdBy', '') == getUserId() ||
        (request.auth.token.email_verified == true &&
         resource.data.get('clientEmail', '') == request.auth.token.email) ||
        resource.data.get('clientUserId', '') == getUserId() ||
        canAccessOrg(resource.data.get('orgId', ''))
      ) &&
      !changesServerManagedCommercialFields() &&
      !editsSignedCommercialTerms() &&
      request.resource.data.get('orgId', '') == resource.data.get('orgId', '') &&
      validNewProjectLink() &&
      ((canCreateAgencyRequest() &&
        (!changesAgencyCommercialFields() || canManageAgencyCommercial())) ||
       (!isAgencyUser() &&
        !isCommercialDocument(resource.data) &&
        !isCommercialDocument(request.resource.data) &&
        !changesAgencyCommercialFields() &&
        !attemptsUnsignedProposalApproval() &&
        // Clients can edit their own request contents and comment previews;
        // commercial, workflow, assignment, identity and audit fields are
        // never writable through a client Firebase SDK transaction.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'type', 'priority', 'tags', 'attachmentIds',
          'clientNotes', 'commentCount', 'lastComment', 'updatedAt'
        ])
      ));
      allow delete: if isAuthenticated() && (
        isAgencyManager() ||
        (!isAgencyUser() && !isCommercialDocument(resource.data) && (
          resource.data.get('createdBy', '') == getUserId() ||
          isOrgOwner(resource.data.get('orgId', ''))
        ))
      );
    }

    match /portal_comments/{commentId} {
      function getRequestOrgIdFromRequest() {
        return exists(/databases/$(database)/documents/portal_requests/$(request.resource.data.get('requestId', '')))
          ? get(/databases/$(database)/documents/portal_requests/$(request.resource.data.get('requestId', ''))).data.get('orgId', '')
          : '';
      }
      function clientCanCommentOnRequest() {
        let requestId = request.resource.data.get('requestId', '');
        let parent = get(/databases/$(database)/documents/portal_requests/$(requestId)).data;
        return exists(/databases/$(database)/documents/portal_requests/$(requestId)) &&
          (!(
            parent.get('isBillable', false) == true ||
            parent.get('publicToken', '') != '' ||
            parent.get('requestRole', '') in ['bundle', 'bundle_item']
          ) || (
            parent.get('status', '') != 'DRAFT' &&
            (parent.get('publicAccessEnabled', false) == true ||
             (parent.get('requestRole', '') == 'bundle_item' &&
              parent.get('status', '') in [
                'QUEUED', 'IN_PROGRESS', 'IN_REVIEW', 'DELIVERED', 'CLOSED'
              ]))
          ));
      }
      // Deny client list queries entirely. Emulator tests proved clients could
      // enumerate confidential notes even with a resource-level predicate.
      // Clients read only through /api/portal/public-comments (authenticated + filtered).
      // Even a non-internal comment may belong to a confidential draft.
      // Client reads are authenticated, request-visibility checked projections.
      allow get, list: if isAuthenticated() && isAgencyUser();
      // Every client comment is created through a trusted API, which checks
      // request visibility, org membership and atomically updates the parent.
      allow create: if isAuthenticated() && isAgencyUser();
      allow update: if isAuthenticated() && (
        isAgencyUser() ||
        (resource != null &&
         resource.data.get('isInternal', false) == false &&
         request.resource.data.get('isInternal', false) == false &&
         resource.data.get('userId', '') == getUserId() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'content', 'updatedAt'
         ]))
      );
      // Client deletions need an atomic parent count adjustment as well.
      allow delete: if isAuthenticated() && isAgencyUser();
    }

    match /portal_files/{fileId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        canAccessOrg(resource.data.get('orgId', '')) ||
        resource.data.get('uploadedBy', '') == getUserId()
      );
      allow create: if isAuthenticated() && (
        isAgencyUser() ||
        isMemberOfOrg(request.resource.data.get('orgId', '')) ||
        isOrgOwner(request.resource.data.get('orgId', ''))
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        resource.data.get('uploadedBy', '') == getUserId() ||
        isAgencyUser()
      );
    }

    match /portal_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        resource.data.get('userId', '') == getUserId()
      );
      allow write: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        resource.data.get('userId', '') == getUserId() ||
        request.resource.data.get('userId', '') == getUserId()
      );
    }

    match /portal_pricing_requests/{requestId} {
      // Rollback/compatibility source only. New writes belong in portal_requests.
      // Legacy commercial documents are private too; public proposal URLs are server-read.
      allow read: if isAuthenticated() && isAgencyUser();
      allow create, update, delete: if false;
    }

    match /portal_request_aliases/{aliasId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /portal_proposal_payments/{paymentId} {
      allow read, write: if false;
    }

    match /portal_payments/{paymentId} {
      // Payment ledger may contain private reconciliation references and notes.
      // Customer receipts are delivered through authenticated billing APIs.
      allow read: if isAuthenticated() && isAgencyUser();
      allow write: if false;
    }

    match /portal_billing_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /_server_rate_limits/{rateLimitId} {
      allow read, write: if false;
    }

    match /portal_profit_splits/{splitId} {
      allow read: if isAuthenticated() && canManageProfitSplits();
      allow create: if isAuthenticated() &&
                    canManageProfitSplits() &&
                    request.resource.data.get('status', '') == 'draft';
      allow update: if isAuthenticated() &&
                    canManageProfitSplits() &&
                    resource.data.get('status', '') == 'draft' &&
                    (
                      request.resource.data.get('status', '') == 'draft' ||
                      isValidProfitSplitFinalization()
                    );
      allow delete: if isAuthenticated() &&
                    canManageProfitSplits() &&
                    resource.data.get('status', '') == 'draft';
    }

    match /portal_activities/{activityId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        resource.data.get('userId', '') == getUserId() ||
        canAccessOrg(resource.data.get('orgId', ''))
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /portal_consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        resource.data.get('createdBy', '') == getUserId() ||
        canAccessOrg(resource.data.get('orgId', ''))
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource == null ||
        isAgencyUser() ||
        resource.data.get('createdBy', '') == getUserId() ||
        canAccessOrg(resource.data.get('orgId', ''))
      );
      allow delete: if isAuthenticated() && isAgencyUser();
    }

    // Testimonials - clients can create/read their own, agency can read/update all
    match /portal_testimonials/{testimonialId} {
      allow read: if isAuthenticated() && (
        isAgencyUser() ||
        resource == null ||
        resource.data.get('userId', '') == getUserId() ||
        canAccessOrg(resource.data.get('orgId', ''))
      );
      allow create: if isAuthenticated() && (
        isMemberOfOrg(request.resource.data.get('orgId', '')) ||
        isOrgOwner(request.resource.data.get('orgId', ''))
      );
      allow update: if isAuthenticated() && (
        isAgencyUser() ||
        (resource.data.get('userId', '') == getUserId() && resource.data.get('status', '') == 'pending')
      );
      allow delete: if isAuthenticated() && isAgencyUser();
    }

    match /agencies/{agencyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserId() == agencyId;
    }

    // Client-visible connection metadata only; never grant cross-user access.
    // Credentials live in private_integration_credentials, accessible only via Admin SDK.
    match /agency_integrations/{integrationId} {
      function isConnectionOwner() {
        return isAgencyUser() &&
          integrationId == getUserId() + '_google_calendar';
      }
      allow read: if isConnectionOwner();
      allow create: if false;
      allow update: if isConnectionOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCalendarId']) &&
        request.resource.data.get('selectedCalendarId', '') is string &&
        request.resource.data.get('selectedCalendarId', '').size() <= 256;
      allow delete: if false;
    }

    match /private_integration_credentials/{credentialId} {
      allow read, write: if false;
    }

    match /portal_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAgencyUser();
    }

    match /system_settings/{settingId} {
      // PUBLIC READ: System settings (feature flags, visibility toggles) are non-sensitive
      // and needed by unauthenticated pages (e.g., pricing page visibility).
      allow read: if true;
      allow write: if isAgencyUser();
    }

    // Outbound research stays server-owned; an authenticated portal session alone
    // never permits direct Firestore access to prospect or evidence records.
    match /agency_prospects/{prospectId} {
      allow read, write: if false;
      match /findings/{findingId} {
        allow read, write: if false;
      }
      match /contacts/{contactId} {
        allow read, write: if false;
      }
    }

    match /agency_prospect_scan_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /agency_prospect_audit/{eventId} {
      allow read, write: if false;
    }

    match /marketing_leads/{leadId} {
      allow read: if isAuthenticated() && isAgencyUser();
      allow create: if false;
      allow delete: if false;
      allow update: if isAuthenticated() && isAgencyUser();
    }

    match /marketing_email_jobs/{jobId} {
      allow read: if isAuthenticated() && isAgencyUser();
      allow write: if false;
    }

    match /marketing_events/{eventId} {
      allow read: if isAuthenticated() && isAgencyUser();
      allow write: if false;
    }

    match /marketing_unsubscribes/{leadId} {
      allow read: if isAuthenticated() && isAgencyUser();
      allow write: if false;
    }

    match /human_review_requests/{requestId} {
      allow read: if isAuthenticated() && isAgencyUser();
      // Only privileged server routes can edit expert workflow, report and delivery fields.
      // Keep older consent/qualification screens compatible, but enforce original consent.
      allow update: if isAuthenticated() && isAgencyUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qualified', 'reviewVisibility', 'updatedAt'
        ])
        && (
          request.resource.data.get('reviewVisibility', 'private') == 'private' ||
          (request.resource.data.get('reviewVisibility', 'private') == 'anonymous_educational'
            && resource.data.get('anonymousInsightConsent', false) == true) ||
          (request.resource.data.get('reviewVisibility', 'private') == 'approved_public_case_study'
            && resource.data.get('namedStoreConsent', false) == true)
        );
      allow create, delete: if false;
    }

    match /store_review_dedupe/{fingerprint} {
      allow read, write: if false;
    }

    match /analyzer_funnel_events/{eventId} {
      allow read: if isAuthenticated() && isAgencyUser();
      allow write: if false;
    }

    match /referral_partners/{partnerId} {
      allow read, update: if isAuthenticated() && isAgencyUser();
      allow create, delete: if false;
    }

    match /store_analysis_reports/{reportId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

